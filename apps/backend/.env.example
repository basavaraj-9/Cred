APP_NAME=Company Intelligence Platform
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/api/v1
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://postgres:change-me@localhost:5432/company_intelligence
TEST_DATABASE_URL=postgresql+psycopg://postgres:change-me@localhost:5432/company_intelligence_test
REDIS_URL=
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=storage
MAX_UPLOAD_SIZE_MB=50
ALLOWED_FILE_TYPES=pdf
OCR_ENABLED=true
OCR_PROVIDER=tesseract
OCR_LANGUAGE=eng
OCR_DPI=200
OCR_TIMEOUT_SECONDS=30
TEXT_QUALITY_MIN_CHARACTERS=50
TEXT_QUALITY_MIN_ALPHANUMERIC_RATIO=0.30
DOMAIN_VERIFIED_THRESHOLD=0.85
DOMAIN_REVIEW_THRESHOLD=0.65
ACCOUNTING_RECONCILIATION_TOLERANCE_PERCENT=1.0
DEBT_RECONCILIATION_TOLERANCE_PERCENT=1.0
CASH_RECONCILIATION_TOLERANCE_PERCENT=1.0

# Day 29: use a randomly generated signing key from your secret manager.
# Never put signing keys/passwords in NEXT_PUBLIC_* variables.
AUTH_SIGNING_KEY=
AUTH_ISSUER=company-intelligence
AUTH_AUDIENCE=company-intelligence-api
ACCESS_TOKEN_MINUTES=15
ALLOWED_ORIGINS=http://localhost:3000
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
HTTPS_DEPLOYMENT=false
QUEUE_BACKEND=database
RATE_LIMIT_BACKEND=memory
REQUEST_TIMEOUT_SECONDS=30
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
JOB_MAX_ATTEMPTS=3
JOB_TIMEOUT_SECONDS=900
WORKER_CONCURRENCY=1
EXTERNAL_RESEARCH_ENABLED=true
STOCK_ML_RESEARCH_ENABLED=true
