{
  "version": "credit_training_config_v1",
  "random_seed": 42,
  "threshold": 0.5,
  "calibration_method": "sigmoid",
  "default_feature_group": "ANOMALY_ENRICHED_V1",
  "logistic_regression": {
    "max_iter": 1000,
    "class_weight": "balanced",
    "C": 1.0
  },
  "random_forest": {
    "n_estimators": 100,
    "max_depth": 4,
    "min_samples_leaf": 1,
    "class_weight": "balanced"
  },
  "xgboost": {
    "n_estimators": 50,
    "max_depth": 3,
    "learning_rate": 0.05,
    "subsample": 1.0,
    "colsample_bytree": 1.0,
    "objective": "binary:logistic",
    "eval_metric": "logloss",
    "n_jobs": 1
  }
}
