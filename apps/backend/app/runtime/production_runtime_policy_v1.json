      "app_name",
      "app_version"
    ],
    "SECRET_CONFIG": [
      "database_url",
      "auth_signing_key",
      "redis_url"
    ],
    "ENVIRONMENT_SPECIFIC": [
      "app_env",
      "allowed_origins",
      "trusted_hosts",
      "local_storage_path"
    ],
    "OPERATIONAL_LIMIT": [
      "request_timeout_seconds",
      "job_timeout_seconds",
      "max_upload_size_mb",
      "worker_concurrency"
    ],
    "POLICY_CONFIG": [
      "authorization_policy_v1",
      "job_retry_policy_v1"
    ]
  }
