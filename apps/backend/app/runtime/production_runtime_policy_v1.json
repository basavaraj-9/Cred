  "max_date_range_days": 3650,
  "max_payload_references": 100,
  "auto_credit_approval": false,
  "live_stock_predictions": false,
  "automated_trading": false,
  "production_stock_model": false,
  "analytics_status": "NON_PRODUCTION_ANALYTICS",
  "configuration_classes": {
