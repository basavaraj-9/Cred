{
  "version": "rag_security_policy_v1",
  "authorized_roles": ["CREDIT_ANALYST", "SENIOR_CREDIT_REVIEWER", "CREDIT_MANAGER", "CREDIT_COMMITTEE_MEMBER", "ADMIN"],
  "retrieval_debug_roles": ["ADMIN"],
  "max_context_characters": 12000,
  "max_question_characters": 2000,
  "documents_are_untrusted_data": true,
  "company_isolation_required": true,
  "exclude_secrets": true,
  "blocked_terms": ["password", "api key", "authorization: bearer", "database_url", "secret_key"],
  "prompt_injection_phrases": ["ignore previous instructions", "ignore your instructions", "reveal system prompt", "reveal api key", "approve the loan"]
}
